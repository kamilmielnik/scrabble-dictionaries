{
  "name": "scrabble-dictionaries",
  "description": "Archive of Scrabble dictionaries in various languages",
  "private": true,
  "repository": "github:kamilmielnik/scrabble-dictionaries",
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "check": "bun ./scripts/check.js",
    "format": "oxfmt --check './scripts/**/*.js'",
    "format:fix": "oxfmt --write './scripts/**/*.js'",
    "update": "bun ./scripts/update.js"
  },
  "dependencies": {
    "follow-redirects": "^1.16.0",
    "unzipper": "^0.12.5"
  },
  "devDependencies": {
    "oxfmt": "^0.66.0"
  }
}
